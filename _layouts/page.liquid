---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header{% if page.header_logos %} post-header--with-logos{% endif %}">
    <div class="post-header__text">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </div>
    {% if page.header_logos %}
      <div class="header-logos">
        {% for logo in page.header_logos %}
          <a href="{{ logo.url }}" target="_blank" rel="noopener" title="{{ logo.name }}" class="header-logos__item {{ logo.class }}">
            {%- if logo.img -%}
              <img src="{{ logo.img | relative_url }}" alt="{{ logo.name }}">
            {%- else -%}
              {{ logo.text }}
            {%- endif -%}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
